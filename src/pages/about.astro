---
import { Icon } from 'astro-icon/components';
import PageLayout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import SectionHeading from '~/components/portfolio/SectionHeading.astro';
import site from '~/data/site.json';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About',
  description:
    'About Joel Saludares, a Business Systems Developer focused on practical systems, automation, data, and implementation.',
};
const projectsUrl = getPermalink('/projects');
const experienceUrl = getPermalink('/experience');
---

<PageLayout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-12 lg:grid-cols-[1.05fr_.95fr] lg:items-start">
        <div>
          <SectionHeading eyebrow="About me" title="A systems developer who enjoys solving real business problems." />
          <div class="mt-7 space-y-5 text-base leading-8 text-slate-600">
            {site.about.intro.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button
              text="Download CV"
              href={getPermalink(site.profile.cvUrl)}
              variant="primary"
              icon="tabler:download"
              download
            />
            <Button text="View projects" href={projectsUrl} variant="secondary" icon="tabler:arrow-right" />
          </div>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6 md:p-8">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">{site.about.howIThink.eyebrow}</p>
          <blockquote
            class="mt-4 border-l-4 border-primary pl-5 text-2xl font-bold leading-tight tracking-tight text-slate-950"
          >
            “{site.about.howIThink.quote}”
          </blockquote>
          <p class="mt-4 text-sm leading-6 text-slate-500">{site.about.howIThink.description}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-4 py-16 sm:px-6 md:py-20">
    <div class="mx-auto max-w-6xl">
      <SectionHeading
        eyebrow="How I work"
        title="A practical, structured approach."
        description="The same principles guide system development, automation, implementation, and improvement work."
      />
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          site.approach.map((item, index) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <div class="flex items-center justify-between">
                <>
                  <span class="text-xs font-bold text-primary">0{index + 1}</span>
                  <Icon name={item.icon} class="h-5 w-5 text-primary" />
                </>
              </div>
              <h3 class="mt-5 text-lg font-bold text-slate-950">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 md:py-20">
    <div class="mx-auto max-w-6xl">
      <SectionHeading
        eyebrow="Skills & technologies"
        title="Tools I work with."
        description="A practical stack shaped by system development, data preparation, reporting, and implementation work."
      />
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          site.skills.map((group) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="font-bold text-slate-950">{group.group}</h3>
              <div class="mt-4 flex flex-wrap gap-2">
                {group.items.map((skill) => (
                  <span class="rounded-full bg-blue-50 px-3 py-1.5 text-sm font-semibold text-blue-700">{skill}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-4 py-16 sm:px-6 md:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading
          eyebrow="Experience"
          title="Systems, data, and implementation across multiple environments."
          description="See the full timeline, responsibilities, and delivery experience."
        />
        <a href={experienceUrl} class="shrink-0 text-sm font-bold text-primary hover:text-secondary"
          >View full experience →</a
        >
      </div>
      <div class="mt-8 space-y-4">
        {
          site.experience.slice(0, 3).map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
              <div class="grid gap-3 sm:grid-cols-[160px_1fr] sm:gap-6">
                <p class="text-sm font-bold text-primary">{item.period}</p>
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider text-slate-400">{item.company}</p>
                  <h3 class="mt-1 text-lg font-bold text-slate-950">{item.role}</h3>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 md:py-20">
    <div class="mx-auto max-w-6xl rounded-3xl bg-slate-950 p-7 text-white sm:p-10">
      <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-300">Education</p>
          <h2 class="mt-3 text-2xl font-bold">{site.education.degree}</h2>
          <p class="mt-1 text-sm text-slate-300">{site.education.school} · {site.education.period}</p>
        </div>
        <a
          href={experienceUrl}
          class="inline-flex items-center justify-center rounded-xl bg-white px-5 py-3 text-sm font-bold text-slate-950 hover:bg-blue-50"
          >View experience →</a
        >
      </div>
    </div>
  </section>
</PageLayout>
