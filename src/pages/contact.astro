---
import { Icon } from 'astro-icon/components';
import PageLayout from '~/layouts/PageLayout.astro';
import SectionHeading from '~/components/portfolio/SectionHeading.astro';
import ContactForm from '~/components/portfolio/ContactForm.astro';
import site from '~/data/site.json';

const metadata = {
  title: 'Contact',
  description: `Get in touch with ${site.profile.name} about systems, automation, data, or technical opportunities.`,
};
---

<PageLayout metadata={metadata}>
  <section class="bg-page px-4 py-16 sm:px-6 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
      <div>
        <SectionHeading
          eyebrow={site.contact.eyebrow}
          title={site.contact.title}
          description={site.contact.description}
        />
        <div class="mt-8 space-y-4">
          <a
            href={`mailto:${site.profile.email}`}
            class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-primary hover:shadow-md"
          >
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-primary"
              ><Icon name="tabler:mail" class="h-5 w-5" /></span
            >
            <span
              ><span class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Email</span><span
                class="mt-1 block font-semibold text-slate-900">{site.profile.email}</span
              ></span
            >
          </a>
          <div class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-primary"
              ><Icon name="tabler:map-pin" class="h-5 w-5" /></span
            >
            <span
              ><span class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Location</span><span
                class="mt-1 block font-semibold text-slate-900">{site.profile.location}</span
              ></span
            >
          </div>
          <div class="flex gap-3 pt-2">
            <a
              href={site.profile.social.linkedin}
              target="_blank"
              rel="noreferrer"
              aria-label="LinkedIn"
              class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 transition hover:border-primary hover:text-primary"
              ><Icon name="tabler:brand-linkedin" class="h-5 w-5" /></a
            >
            <a
              href={site.profile.social.github}
              target="_blank"
              rel="noreferrer"
              aria-label="GitHub"
              class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 transition hover:border-primary hover:text-primary"
              ><Icon name="tabler:brand-github" class="h-5 w-5" /></a
            >
          </div>
        </div>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5 shadow-sm sm:p-8">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">{site.contact.formTitle}</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">{site.contact.formNote}</p>
        <div class="mt-6"><ContactForm /></div>
      </div>
    </div>
  </section>
</PageLayout>
