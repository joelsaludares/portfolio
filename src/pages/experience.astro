---
import { Icon } from 'astro-icon/components';
import PageLayout from '~/layouts/PageLayout.astro';
import SectionHeading from '~/components/portfolio/SectionHeading.astro';
import site from '~/data/site.json';

const metadata = {
  title: 'Experience',
  description:
    'Professional experience in system development, data support, automation, UAT, and enterprise application delivery.',
};
---

<PageLayout metadata={metadata}>
  <section class="bg-page px-4 py-16 sm:px-6 md:py-24">
    <div class="mx-auto max-w-6xl">
      <SectionHeading
        eyebrow="Professional experience"
        title="A career built around systems, data, and implementation."
        description="Selected roles and responsibilities from my professional experience."
      />

      <div class="mt-12 space-y-6">
        {
          site.experience.map((item) => (
            <article class="relative rounded-3xl border border-slate-200 bg-white p-6 shadow-sm md:grid md:grid-cols-[180px_1fr] md:gap-8 md:p-8">
              <div class="text-sm font-bold text-primary">{item.period}</div>

              <div class="relative md:border-l md:border-slate-200 md:pl-8">
                <span
                  class="absolute -left-[5px] top-1 hidden h-2.5 w-2.5 rounded-full bg-primary md:block"
                  aria-hidden="true"
                />

                <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">{item.company}</p>

                <h2 class="mt-1 text-xl font-bold tracking-tight text-slate-950">{item.role}</h2>

                <p class="mt-2 text-sm font-semibold text-slate-500">{item.project}</p>

                <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-600">
                  {item.bullets.map((bullet) => (
                    <li class="flex gap-2">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-16 grid gap-6 lg:grid-cols-2">
        <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm md:p-8">
          <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-primary">
            <Icon name="tabler:school" class="h-5 w-5" />
          </div>

          <h2 class="mt-5 text-xl font-bold text-slate-950">Education</h2>

          <p class="mt-2 text-lg font-semibold text-slate-800">{site.education.degree}</p>

          <p class="mt-1 text-sm text-slate-500">{site.education.school}</p>

          <p class="mt-2 text-sm text-slate-500">{site.education.period}</p>
        </article>

        <article class="rounded-3xl border border-slate-200 bg-slate-950 p-6 text-white shadow-sm md:p-8">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-300">
            {site.about.currentDirection.eyebrow}
          </p>

          <h2 class="mt-3 text-2xl font-bold">{site.about.currentDirection.title}</h2>

          <p class="mt-3 text-sm leading-6 text-slate-300">
            {site.about.currentDirection.description}
          </p>
        </article>
      </div>
    </div>
  </section>
</PageLayout>
