---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import PageLayout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import SectionHeading from '~/components/portfolio/SectionHeading.astro';
import ProjectCard from '~/components/portfolio/ProjectCard.astro';
import site from '~/data/site.json';
import { getPermalink, getAsset } from '~/utils/permalinks';

const projectYear = (year: string) => (Number.isFinite(Number(year)) ? Number(year) : 9999);

const projects = (await getCollection('project'))
  .filter((project) => project.data.featured)
  .sort((a, b) => projectYear(b.data.year) - projectYear(a.data.year))
  .slice(0, 4);

const metadata = {
  title: 'Business Systems Developer',
  description: site.profile.description,
  ignoreTitleTemplate: true,
};

const projectsUrl = getPermalink('/projects');
const contactUrl = getPermalink('/contact');
---

<PageLayout metadata={metadata}>
  <section class="relative overflow-hidden bg-page">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_86%_12%,rgba(37,99,235,.12),transparent_34%),radial-gradient(circle_at_12%_88%,rgba(14,165,233,.08),transparent_28%)]"
    >
    </div>

    <div class="relative mx-auto max-w-7xl px-4 pb-14 pt-14 sm:px-6 md:pb-20 md:pt-20 lg:pt-24">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_.9fr] lg:gap-16">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">
            {site.profile.tagline}
          </p>

          <h1
            class="mt-4 max-w-4xl text-5xl font-bold leading-[1.02] tracking-tight text-slate-950 sm:text-6xl lg:text-7xl"
          >
            {site.profile.headlineLead}
            <span class="text-primary">{site.profile.headlineAccent}</span>
          </h1>

          <p class="mt-6 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
            {site.profile.description}
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <Button
              text={site.home.actions.projects}
              href={projectsUrl}
              variant="primary"
              icon="tabler:arrow-right"
              class="w-full sm:w-auto"
            />

            <Button
              text={site.home.actions.cv}
              href={getAsset(site.profile.cvUrl)}
              variant="secondary"
              icon="tabler:download"
              download
              class="w-full sm:w-auto"
            />

            <a
              href={contactUrl}
              class="inline-flex items-center justify-center px-2 py-3 text-sm font-bold text-primary hover:text-secondary sm:justify-start"
            >
              {site.home.actions.contact}
              <span aria-hidden="true" class="ml-1">→</span>
            </a>
          </div>
        </div>

        <div
          class="relative min-h-[360px] overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-xl shadow-slate-200/50"
        >
          <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(239,246,255,.98),rgba(255,255,255,.75))]"></div>
          <div class="absolute right-7 top-7 h-20 w-20 rounded-full bg-blue-100"></div>
          <div class="absolute left-8 top-14 h-4 w-4 rounded-full bg-primary/80"></div>
          <div class="absolute bottom-0 right-0 h-48 w-48 rounded-full bg-sky-100 blur-3xl"></div>

          <div class="relative flex h-full min-h-[360px] flex-col justify-between p-8 sm:p-10">
            <div class="flex items-center justify-between">
              <span
                class="rounded-full border border-slate-200 bg-white/80 px-3 py-1.5 text-xs font-semibold text-slate-600"
              >
                {site.home.heroPanel.label}
              </span>

              <Icon name="tabler:code-dots" class="h-7 w-7 text-primary" />
            </div>

            <div class="max-w-sm">
              <p class="font-mono text-xs uppercase tracking-[0.24em] text-slate-400">
                {site.home.heroPanel.eyebrow}
              </p>

              <p class="mt-4 text-3xl font-bold leading-tight text-slate-950">
                {site.home.heroPanel.headline}
              </p>

              <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
                {
                  site.home.heroPanel.items.map((item) => (
                    <span class="rounded-xl bg-white/90 px-3 py-2 text-center text-xs font-semibold text-slate-600 shadow-sm">
                      {item}
                    </span>
                  ))
                }
              </div>
            </div>

            <div class="flex items-end justify-between gap-4">
              <div class="h-1.5 w-36 rounded-full bg-slate-200">
                <div class="h-full w-3/4 rounded-full bg-primary"></div>
              </div>

              <span class="text-xs font-semibold text-slate-400">
                {site.home.heroPanel.footerLabel}
              </span>
            </div>
          </div>
        </div>
      </div>

      <div
        class="mt-14 grid grid-cols-2 divide-x divide-y divide-slate-200 border-y border-slate-200 sm:grid-cols-4 sm:divide-y-0"
      >
        {
          site.stats.map((stat) => (
            <div class="px-4 py-6 first:pl-0 sm:px-6 sm:first:pl-0">
              <p class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">{stat.value}</p>

              <p class="mt-1 text-xs font-medium text-slate-500 sm:text-sm">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-4 py-16 sm:px-6 md:py-20">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading
          eyebrow={site.home.featured.eyebrow}
          title={site.home.featured.title}
          description={site.home.featured.description}
        />

        <a href={projectsUrl} class="shrink-0 text-sm font-bold text-primary hover:text-secondary">
          {site.home.featured.linkLabel} →
        </a>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="bg-page px-4 py-16 sm:px-6 md:py-20">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        eyebrow={site.home.focus.eyebrow}
        title={site.home.focus.title}
        description={site.home.focus.description}
      />

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          site.focusAreas.map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
              <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-primary">
                <Icon name={item.icon} class="h-5 w-5" />
              </div>

              <h3 class="mt-5 text-lg font-bold text-slate-950">{item.title}</h3>

              <p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-slate-950 px-4 py-16 text-white sm:px-6 md:py-20">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-center">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-300">
          {site.home.approach.eyebrow}
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          {site.home.approach.title}
        </h2>

        <p class="mt-4 max-w-xl text-base leading-7 text-slate-300">
          {site.home.approach.description}
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          site.approach.map((item, index) => (
            <div class="rounded-2xl border border-slate-800 bg-slate-900 p-5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-blue-300">0{index + 1}</span>
                <Icon name={item.icon} class="h-5 w-5 text-blue-300" />
              </div>

              <h3 class="mt-5 font-bold">{item.title}</h3>

              <p class="mt-2 text-sm leading-6 text-slate-400">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 md:py-20">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-6 rounded-3xl bg-[linear-gradient(135deg,#eff6ff,#f8fafc)] p-7 sm:p-10 lg:flex-row lg:items-center lg:justify-between"
    >
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">
          {site.home.cta.eyebrow}
        </p>

        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">
          {site.home.cta.title}
        </h2>

        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600">
          {site.home.cta.description}
        </p>
      </div>

      <Button
        text={site.home.actions.cta}
        href={contactUrl}
        variant="primary"
        icon="tabler:arrow-right"
        class="shrink-0"
      />
    </div>
  </section>
</PageLayout>
