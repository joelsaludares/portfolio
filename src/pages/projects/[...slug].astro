---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import PageLayout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import ProjectGallery from '~/components/portfolio/ProjectGallery.astro';
import { getPermalink } from '~/utils/permalinks';

export async function getStaticPaths() {
  const projects = await getCollection('project');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, client, year, status, category, role, techStack, gallery, image, summary } = project.data;
const galleryImages = Array.from(new Set([image, ...(gallery || [])]));
const metadata = { title, description: summary };
const projectsUrl = getPermalink('/projects');
const contactUrl = getPermalink('/contact');
---

<PageLayout metadata={metadata}>
  <section class="px-4 py-12 sm:px-6 md:py-20">
    <div class="mx-auto max-w-6xl">
      <a href={projectsUrl} class="inline-flex items-center gap-1 text-sm font-bold text-primary hover:text-secondary"
        >← Back to projects</a
      >

      <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_300px]">
        <div>
          <div class="flex flex-wrap gap-2">
            <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-primary">{category}</span>
            <span
              class:list={[
                'rounded-full px-3 py-1 text-xs font-bold',
                status === 'Ongoing' ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-700',
              ]}>{status}</span
            >
          </div>
          <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">{title}</h1>
          <p class="mt-2 text-base font-semibold text-slate-500">{client} · {year}</p>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">{summary}</p>
          <div class="mt-8"><ProjectGallery title={title} images={galleryImages} /></div>

          <article
            class="prose prose-slate mt-12 max-w-none prose-headings:scroll-mt-24 prose-a:text-primary prose-li:marker:text-primary"
          >
            <Content />
          </article>
        </div>

        <aside class="lg:sticky lg:top-24 lg:self-start">
          <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-slate-950">Project overview</h2>
            <dl class="mt-5 space-y-5 text-sm">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Client</dt><dd
                  class="mt-1 font-semibold text-slate-800"
                >
                  {client}
                </dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Year</dt><dd
                  class="mt-1 font-semibold text-slate-800"
                >
                  {year}
                </dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">My role</dt><dd
                  class="mt-1 leading-6 text-slate-700"
                >
                  {role}
                </dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Status</dt><dd
                  class="mt-1 font-semibold text-slate-800"
                >
                  {status}
                </dd>
              </div>
            </dl>
            <div class="mt-6 border-t border-slate-100 pt-6">
              <h3 class="text-sm font-bold text-slate-950">Technology</h3>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  techStack.map((tech) => (
                    <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700">
                      {tech}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
          <div class="mt-4 rounded-3xl bg-slate-950 p-6 text-white">
            <Icon name="tabler:message-circle" class="h-5 w-5 text-blue-300" />
            <h2 class="mt-4 text-xl font-bold">Need something similar?</h2>
            <p class="mt-2 text-sm leading-6 text-slate-300">
              Let’s talk about the workflow, reporting, or system you’re trying to improve.
            </p>
            <Button
              text="Get in touch"
              href={contactUrl}
              variant="primary"
              icon="tabler:arrow-right"
              class="mt-5 w-full"
            />
          </div>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>
